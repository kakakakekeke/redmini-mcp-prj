#!/bin/sh
# Git pre-commit hook to enforce branch protection, document index, and tests.

GIT_DIR=$(git rev-parse --git-dir)
GIT_COMMON_DIR=$(git rev-parse --git-common-dir)

# 0. Merge Commit 허용 로직
if [ -f "$GIT_DIR/MERGE_HEAD" ]; then
    echo "✅ Merge Commit이 감지되어 가드레일 검사를 건너뜁니다."
    exit 0
fi

# 1. 메인 저장소(Main Repository) 가드레일
if [ "$GIT_DIR" = "$GIT_COMMON_DIR" ]; then
    STAGED_FILES=$(git diff --cached --name-only)
    for FILE in $STAGED_FILES; do
        case "$FILE" in
            document/todo.md | document/index.md | document/decision_log/* | document/adr/* | .env)
                # 화이트리스트 패스
                ;;
            *)
                echo "❌ [Error] 메인 저장소에서는 문서(todo.md, index.md, DL, ADR 등) 및 .env 외의 개발 코드나 스크립트($FILE)를 직접 커밋할 수 없습니다."
                echo "반드시 서브에이전트(Workspace: share) 환경이나 'git worktree add'를 통해 작업하세요."
                exit 1
                ;;
        esac
    done
fi

BRANCH_NAME=$(git symbolic-ref --short HEAD 2>/dev/null)

# 2. Run document/index.md check (기존 로직 유지)
if [ -f ".agents/scripts/enforce_document_index.sh" ]; then
    OUTPUT=$(.agents/scripts/enforce_document_index.sh << 'INPUT'
{"terminationReason": "model_stop"}
INPUT
)
    if echo "$OUTPUT" | grep -q '"decision":"continue"'; then
        echo "❌ [Git Pre-Commit Error] document/index.md 검증에 실패하여 커밋이 차단되었습니다:"
        echo "$OUTPUT"
        exit 1
    fi
fi

# 3. Unit test enforcement
if grep -q '"test":' package.json; then
    echo "🧪 단위 테스트를 실행합니다..."
    npm test > /dev/null
    if [ $? -ne 0 ]; then
        echo "❌ [Error] 단위 테스트가 실패했습니다. 테스트 실패 원인을 분석하고 코드를 수정한 후 커밋하세요."
        exit 1
    fi
fi

# 4. Queue-driven Development Enforcement (todo.md) - 완화됨 (Warning only)
TODO_FILE="document/todo.md"
if [ -f "$TODO_FILE" ] && [ "$BRANCH_NAME" != "main" ] && [ "$BRANCH_NAME" != "master" ]; then

    if grep -Eq '^[0-9]+\. \[x\]' "$TODO_FILE"; then
        echo "⚠️ [Queue Warning] 완료된 작업([x])이 대기열에 남아 있습니다."
    fi

    FIRST_INCOMPLETE_BRANCH=$(grep -E '^[0-9]+\. \[[ /]\] `[^`]+`' "$TODO_FILE" | head -n 1 | grep -o '`[^`]*`' | sed 's/`//g')
    
    if [ -n "$FIRST_INCOMPLETE_BRANCH" ] && [ "$BRANCH_NAME" != "$FIRST_INCOMPLETE_BRANCH" ]; then
        echo "⚠️ [Queue Warning] 1순위 작업과 현재 브랜치가 다릅니다."
    fi
fi

echo "✅ Pre-commit 검증을 통과했습니다."
