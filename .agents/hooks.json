{
  "document-index-enforcer": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "scripts/enforce_document_index.sh",
        "timeout": 5
      }
    ]
  },
  "vibe-tdd-typecheck": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/typecheck.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree-enforcer": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/enforce_worktree.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "subagent-workspace-enforcer": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/enforce_subagent_workspace.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
