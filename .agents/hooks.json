{
  "document-index-enforcer": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "scripts/enforce_document_index.sh",
        "timeout": 5
      }
    ]
  },
  "vibe-tdd-typecheck": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/typecheck.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "commit-workflow-enforcer": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./.agents/scripts/enforce_commit_workflow.sh \"{{CommandLine}}\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
