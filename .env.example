# Redmine Server Configuration
REDMINE_URL=http://localhost:3000
# REDMINE_API_KEY는 TRANSPORT=stdio 모드에서만 사용됩니다.
# HTTP 모드에서는 각 클라이언트 요청의 X-Redmine-API-Key 헤더가 엄격히 요구됩니다.
REDMINE_API_KEY=your_redmine_api_key_here

# Server Transport Mode (http or stdio)
TRANSPORT=http
PORT=3000

# Security Configuration
# MCP HTTP 엔드포인트(/mcp) Bearer 토큰 인증 (미설정 시 인증 검사 건너뜀)
MCP_AUTH_TOKEN=your_secret_mcp_bearer_token

# 참고: HTTP 모드에서는 보안(Confused Deputy 방지)을 위해 REDMINE_API_KEY 폴백이 완전 차단되며,
# 매 요청마다 X-Redmine-API-Key 헤더가 필수입니다.

# Rate Limiting Configuration (Streamable HTTP mode)
# /mcp 엔드포인트 1분당 최대 요청 수: 120회
# /health 엔드포인트 1분당 최대 요청 수: 300회

# CORS Configuration (Streamable HTTP mode)
# 허용할 출처(Origin)들을 쉼표(,)로 구분하여 입력 (예: http://localhost:3000,http://localhost:5173,https://my-app.domain.com)
# 미설정 시 기본적으로 localhost 및 127.0.0.1 포트가 허용됩니다. 전체 허용은 * 를 입력하세요.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
